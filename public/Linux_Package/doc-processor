#!/usr/bin/env python3
import sys
import os

# АБСОЛЮТНЫЙ путь к виртуальному окружению
VENV_PATH = "/opt/dococr/venv"

# Активация виртуального окружения
activate_script = os.path.join(VENV_PATH, "bin", "activate_this.py")
if os.path.exists(activate_script):
    with open(activate_script) as f:
        exec(f.read(), {'__file__': activate_script})
else:
    # Альтернативный способ - добавляем site-packages в путь
    for version in ['3.11', '3.10', '3.9', '3.8', '3.7']:
        site_packages = os.path.join(VENV_PATH, "lib", f"python{version}", "site-packages")
        if os.path.exists(site_packages):
            sys.path.insert(0, site_packages)
            break

# Добавляем наши модули
sys.path.insert(0, "/opt/dococr")
sys.path.insert(0, "/opt/dococr/src")

# Отладка (можно убрать после настройки)
print(f"Python path: {sys.path[:3]}...", file=sys.stderr)

try:
    from src.cli import main
    sys.exit(main())
except ImportError as e:
    print(f"  Ошибка импорта: {e}")
    sys.exit(1)